{
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@music/web",
  "installCommand": "cd ../.. && pnpm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 1 * *"
    },
    {
      "path": "/api/cron/notebook-note",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 3 */3 * *"
    }
  ]
}
