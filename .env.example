# Private dashboard password (WeekOS pattern; verified server-side, httpOnly cookie)
MUSIC_OS_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Coach — Google Gemini (free tier via AI Studio; server-only)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
