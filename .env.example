# ─────────────────────────────────────────────────────────────
# apps/web/.env.local — copy and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Private dashboard password (WeekOS pattern; verified server-side, httpOnly cookie)
MUSIC_OS_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Coach — Google Gemini (free tier via AI Studio; server-only)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Notebook backup (Phase 10) — monthly email; download works without these
RESEND_API_KEY=
BACKUP_EMAIL=
# At least 16 characters. Vercel sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Optional. Defaults to Resend's onboarding sender for a first test.
# BACKUP_FROM_EMAIL=Music OS <notebook@your-verified-domain.com>
